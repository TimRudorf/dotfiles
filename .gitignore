# Machine-specific overrides
*.local.conf
local.conf
*.local.json

# Generated files
*.lock.json
*-generated.conf

# claude/.claude/ ist das stow-Paket UND das Arbeitsverzeichnis, das Claude Code
# anlegt, wenn jemand in ~/dotfiles/claude/ arbeitet. Deshalb gezielt nur die
# Laufzeitdaten ignorieren — eine Regel auf das ganze Verzeichnis wuerde neue
# Konfigurationsdateien stillschweigend verschlucken.
claude/.claude/agent-memory/
claude/.claude/downloads/
claude/.claude/file-history/
claude/.claude/image-cache/
claude/.claude/paste-cache/
claude/.claude/plans/
claude/.claude/projects/
claude/.claude/shell-snapshots/
claude/.claude/statsig/
claude/.claude/tasks/
claude/.claude/telemetry/
claude/.claude/todos/
claude/.claude/settings.local.json
claude/.claude/stats-cache.json
claude/.claude/*.jsonl

# Secrets — never commit decrypted values
.env
.env.bak-*
secrets/*.env
!secrets/*.sops
# age private keys — must never leave the host
keys.txt
*.age-key

# Python artifacts (Skill-Tests/-Tools)
__pycache__/
*.pyc

# playwright-cli persistentes Profil (lokaler Skill-Lauf, nie versionieren)
.playwright-cli/

# OS artifacts
.DS_Store
Thumbs.db

# edp-ctrl Skill-Install-Marker (volatil, bumpt bei jedem `edp-ctrl update`)
claude/skills/*/.version
