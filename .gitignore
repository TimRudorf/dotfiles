# Machine-specific overrides
*.local.conf
local.conf
*.local.json

# Generated files
*.lock.json
*-generated.conf

# claude/.claude/ ist das stow-Paket UND das Arbeitsverzeichnis, das Claude Code
# anlegt, wenn jemand in ~/dotfiles/claude/ arbeitet. Deshalb WHITELIST statt
# Blacklist: alles ignorieren, nur die Konfiguration durchlassen. Eine Liste
# der Laufzeitverzeichnisse waere sonst nach dem naechsten Claude-Update
# unvollstaendig, ohne dass es jemand merkt.
#
# Neue Konfigurationsdatei im Paket? Hier eine Zeile ergaenzen — sonst wird sie
# stillschweigend nicht committet.
claude/.claude/*
!claude/.claude/CLAUDE.md
!claude/.claude/PERSONALITY.md
!claude/.claude/RULES.md
!claude/.claude/settings.json
!claude/.claude/skills/

# Secrets — never commit decrypted values
.env
.env.bak-*
secrets/*.env
!secrets/*.sops
# age private keys — must never leave the host
keys.txt
*.age-key

# Python artifacts (Skill-Tests/-Tools)
__pycache__/
*.pyc

# playwright-cli persistentes Profil (lokaler Skill-Lauf, nie versionieren)
.playwright-cli/

# OS artifacts
.DS_Store
Thumbs.db

# edp-ctrl Skill-Install-Marker (volatil, bumpt bei jedem `edp-ctrl update`)
claude/skills/*/.version

# Arbeitsverzeichnis, das Claude Code im Repo-Wurzelverzeichnis anlegt, wenn
# jemand von ~/dotfiles/ aus arbeitet. Der fuehrende Schraegstrich ist wichtig:
# claude/.claude/ ist das stow-Paket und muss weiter erfasst werden.
/.claude/
